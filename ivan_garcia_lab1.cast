[898.919215, "o", "\u001b[1;1H\u001b[33mdef\u001b[m \u001b[36mfib\u001b[m(n, sequence):\r\n    \u001b[33mif\u001b[m \u001b[36mlen\u001b[m(sequence) < \u001b[31m2\u001b[m:\u001b[2;26H\u001b[K\u001b[3;1H        sequence = [\u001b[31m0\u001b[m,\u001b[31m1\u001b[m]\u001b[3;25H\u001b[K\u001b[5;5H\u001b[33mif\u001b[m n <= \u001b[31m2\u001b[m:\u001b[6;9H\u001b[33mreturn\u001b[m sequence\r\n    \u001b[33melse\u001b[m:\u001b[8;9Hnext_num = sequence[-\u001b[31m1\u001b[m] + sequence[-\u001b[31m2\u001b[m]\u001b[9;9Hsequence.append(next_num)\u001b[10;9H\u001b[33mreturn\u001b[m fib(n-\u001b[31m1\u001b[m,sequence)\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mprint_seq\u001b[m(seq):\r\n    \u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'./output/fibonacci.txt'\u001b[m,\u001b[31m'w'\u001b[m) \u001b[33mas\u001b[m file:\u001b[14;9H\u001b[33mfor\u001b[m entry \u001b[33min\u001b[m seq:\u001b[15;13Hfile.write(f\u001b[31m'{entry}\u001b[m\u001b[35m\\n\u001b[m\u001b[31m'\u001b[m)\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mmain\u001b[m():\r\n    sequence = []\r\n    sequence = fib(\u001b[31m25\u001b[m, sequence)\r\n    \u001b[36mprint\u001b[m(f\u001b[31m'Sequence size: {len(sequence)}'\u001b[m)\r\n    print_seq(sequence)\r\n    \u001b[36mprint\u001b[m(\u001b[31m'done'\u001b[m)\r\n\r\n\u001b[33mif\u001b[m __name__ == \u001b[31m\"__main__\"\u001b[m:\r\n    main()\r\n\u001b[1m\u001b[34m~                                                                                                                       \u001b[27;1H~                                                                                                                       \u001b[28;1H~                                                                                                                       \u001b[29;1H~                                                                                                                       \u001b[m\u001b[30;103H21,13\u001b[9CAll\u001b[21;13H\u001b[?25h\u001b[?4m\u001b[?12$p"]
[898.919539, "o", "\u001b[?25l\u001b[30;93H/\u001b[21;13H\u001b[30;94H0\u001b[21;13H\u001b[30;95Hc\u001b[21;13H\u001b[30;96H0\u001b[21;13H\u001b[30;97Hc\u001b[21;13H\u001b[30;98H/\u001b[21;13H\u001b[30;99H0\u001b[21;13H\u001b[30;100Hc\u001b[21;13H\u001b[30;101H0\u001b[21;13H\u001b[30;102Hc\u001b[21;13H"]
[898.921432, "o", "\u001b[30;93H          \u001b[21;13H\u001b[27m\u001b[23m\u001b[29m\u001b[m\u001b[H\u001b[2J\u001b[1;1H\u001b[1m\u001b[33mdef\u001b[m \u001b[1m\u001b[36mfib\u001b[m(n, sequence):\r\n    \u001b[1m\u001b[33mif\u001b[m \u001b[1m\u001b[36mlen\u001b[m(sequence) < \u001b[1m\u001b[35m2\u001b[m:\u001b[3;9Hsequence = [\u001b[1m\u001b[35m0\u001b[m,\u001b[1m\u001b[35m1\u001b[m]\u001b[5;5H\u001b[1m\u001b[33mif\u001b[m n <= \u001b[1m\u001b[35m2\u001b[m:\u001b[6;9H\u001b[1m\u001b[33mreturn\u001b[m sequence\r\n    \u001b[1m\u001b[33melse\u001b[m:\u001b[8;9Hnext_num = sequence[-\u001b[1m\u001b[35m1\u001b[m] + sequence[-\u001b[1m\u001b[35m2\u001b[m]\u001b[9;9Hsequence.append(next_num)\u001b[10;9H\u001b[1m\u001b[33mreturn\u001b[m fib(n-\u001b[1m\u001b[35m1\u001b[m,sequence)\r\n\r\n\u001b[1m\u001b[33mdef\u001b[m \u001b[1m\u001b[36mprint_seq\u001b[m(seq):\r\n    \u001b[1m\u001b[33mwith\u001b[m \u001b[1m\u001b[36mopen\u001b[m(\u001b[1m\u001b[35m'./output/fibonacci.txt'\u001b[m,\u001b[1m\u001b[35m'w'\u001b[m) \u001b[1m\u001b[33mas\u001b[m file:\u001b[14;9H\u001b[1m\u001b[33mfor\u001b[m entry \u001b[1m\u001b[33min\u001b[m seq:\u001b[15;13Hfile.write(f\u001b[1m\u001b[35m'{entry}\u001b[m\u001b[1m\u001b[31m\\n\u001b[m\u001b[1m\u001b[35m'\u001b[m)\r\n\r\n\u001b[1m\u001b[33mdef\u001b[m \u001b[1m\u001b[36mmain\u001b[m():\r\n    sequence = []\r\n    sequence = fib(\u001b[1m\u001b[35m25\u001b[m, sequence)\r\n    \u001b[1m\u001b[36mprint\u001b[m(f\u001b[1m\u001b[35m'Sequence size: {len(sequence)}'\u001b[m)\r\n    print_seq(sequence)\r\n    \u001b[1m\u001b[36mprint\u001b[m(\u001b[1m\u001b[35m'done'\u001b[m)\r\n\r\n\u001b[1m\u001b[33mif\u001b[m __name__ == \u001b[1m\u001b[35m\"__main__\"\u001b[m:\r\n    main()\r\n\u001b[1m\u001b[34m~                                                                                                                       \u001b[27;1H~                                                                                                                       \u