[579.225513, "o", "\u001b[1;1H\u001b[33mdef\u001b[m \u001b[36mfib\u001b[m(n):\r\n    fib_0 = \u001b[31m0\u001b[m\u001b[2;14H\u001b[K\u001b[3;1H    fib_1 = \u001b[31m1\u001b[m\u001b[3;14H\u001b[K\u001b[4;5Hseq = [fib_0, fib_1]\u001b[6;5H\u001b[33mfor\u001b[m i \u001b[33min\u001b[m \u001b[36mrange\u001b[m(\u001b[31m2\u001b[m,n):\u001b[7;9Hnext_num = seq[i-\u001b[31m1\u001b[m] + seq[i-\u001b[31m2\u001b[m]\u001b[8;9Hseq.append(next_num)\u001b[10;5H\u001b[33mreturn\u001b[m seq\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mprint_seq\u001b[m(seq):\r\n    \u001b[33mwith\u001b[m \u001b[36mopen\u001b[m(\u001b[31m'./output/fibonacci.txt'\u001b[m,\u001b[31m'w'\u001b[m) \u001b[33mas\u001b[m file:\u001b[14;9H\u001b[33mfor\u001b[m entry \u001b[33min\u001b[m seq:\u001b[15;13Hfile.write(f\u001b[31m'{entry}\u001b[m\u001b[35m\\n\u001b[m\u001b[31m'\u001b[m)\r\n\r\n\u001b[33mdef\u001b[m \u001b[36mmain\u001b[m():\r\n    sequence = fib(\u001b[31m25\u001b[m)\r\n    print_seq(sequence)\r\n\r\n\u001b[33mif\u001b[m __name__ == \u001b[31m\"__main__\"\u001b[m:\r\n    main()\r\n\u001b[1m\u001b[34m~                                                                                                                       \u001b[24;1H~                                                                                                                       \u001b[25;1H~                                                                                                                       \u001b[26;1H~                                                                                                                       \u001b[27;1H~                                                                                                                       \u001b[28;1H~                                                                                                                       \u001b[29;1H~                                                                                                                       \u001b[m\u0